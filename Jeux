<!doctype html>
<html lang="fr">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,maximum-scale=1,user-scalable=no">
<title>Echo Loop</title>
<style>
  html,body{margin:0;height:100%;overflow:hidden;background:#07111f;font-family:system-ui,-apple-system,Segoe UI,Roboto,Arial,sans-serif;color:#fff}
  canvas{display:block;width:100vw;height:100vh;touch-action:none}
  #ui{position:fixed;inset:0;pointer-events:none}
  .panel{position:absolute;left:12px;top:12px;max-width:min(92vw,360px);background:rgba(0,0,0,.38);backdrop-filter:blur(8px);border:1px solid rgba(255,255,255,.08);border-radius:16px;padding:12px 14px;pointer-events:auto}
  h1{font-size:20px;margin:0 0 6px}
  p{margin:6px 0 0;line-height:1.35;font-size:14px;opacity:.92}
  .row{display:flex;gap:8px;flex-wrap:wrap;margin-top:10px}
  button{appearance:none;border:0;border-radius:12px;padding:10px 14px;font-weight:700;background:#7c5cff;color:#fff}
  button.secondary{background:#20304f}
  .hud{position:absolute;right:12px;top:12px;text-align:right;background:rgba(0,0,0,.28);padding:10px 12px;border-radius:14px;pointer-events:none}
  .big{font-size:28px;font-weight:800;line-height:1}
  .small{font-size:12px;opacity:.8;margin-top:4px}
  .touch{position:absolute;left:0;right:0;bottom:0;display:flex;justify-content:space-between;align-items:flex-end;padding:16px;pointer-events:none}
  .pad{display:grid;grid-template-columns:64px 64px 64px;grid-template-rows:64px 64px 64px;gap:8px;pointer-events:auto}
  .pad button{width:64px;height:64px;border-radius:16px;background:rgba(32,48,79,.86);border:1px solid rgba(255,255,255,.1);font-size:18px}
  .pad .blank{visibility:hidden}
  .action{pointer-events:auto;display:flex;gap:10px}
  .action button{width:88px;height:88px;border-radius:22px;font-size:16px;background:#22c55e}
  .action button#restart{background:#ef4444}
  #overlay{position:absolute;inset:0;display:none;align-items:center;justify-content:center;background:rgba(0,0,0,.25);pointer-events:auto}
  #card{background:rgba(6,12,24,.92);border:1px solid rgba(255,255,255,.1);border-radius:22px;padding:20px 18px;max-width:320px;text-align:center}
  #card h2{margin:0 0 8px;font-size:30px}
  #card p{font-size:14px;opacity:.92}
  @media (min-width:900px){.touch{max-width:760px;margin:0 auto;left:50%;transform:translateX(-50%)}}
</style>
</head>
<body>
<canvas id="game"></canvas>
<div id="ui">
  <div class="panel" id="startPanel">
    <h1>Echo Loop</h1>
    <p>Atteins le carré vert. À chaque tentative, ton ancien parcours revient sous forme de fantôme.</p>
    <div class="row">
      <button id="playBtn">Jouer</button>
      <button class="secondary" id="howBtn">Comment jouer</button>
    </div>
    <p id="helpText" style="display:none">Déplace-toi avec WASD ou les flèches. Sur téléphone, utilise les boutons en bas. Les fantômes rejouent tes mouvements et peuvent t’aider à ouvrir le chemin.</p>
  </div>
  <div class="hud">
    <div class="big" id="levelTxt">Niveau 1</div>
    <div class="small" id="ghostTxt">Fantômes: 0</div>
  </div>
  <div class="touch">
    <div class="pad">
      <div class="blank"></div><button data-k="ArrowUp">▲</button><div class="blank"></div>
      <button data-k="ArrowLeft">◀</button><button data-k="">•</button><button data-k="ArrowRight">▶</button>
      <div class="blank"></div><button data-k="ArrowDown">▼</button><div class="blank"></div>
    </div>
    <div class="action">
      <button id="restart">Restart</button>
    </div>
  </div>
  <div id="overlay"><div id="card"><h2 id="overTitle">Gagné !</h2><p id="overText">Tu peux passer au niveau suivant.</p><div class="row" style="justify-content:center"><button id="nextBtn">Continuer</button></div></div></div>
</div>
<script>
const canvas=document.getElementById('game');
const ctx=canvas.getContext('2d');
const keys={};
const levelTxt=document.getElementById('levelTxt');
const ghostTxt=document.getElementById('ghostTxt');
const overlay=document.getElementById('overlay');
const overTitle=document.getElementById('overTitle');
const overText=document.getElementById('overText');
const playBtn=document.getElementById('playBtn');
const restartBtn=document.getElementById('restart');
const nextBtn=document.getElementById('nextBtn');
const howBtn=document.getElementById('howBtn');
const helpText=document.getElementById('helpText');
let W=0,H=0,level=1,started=false,win=false,frames=0,ghosts=[],currentRun=[],player,goal,walls=[];
let levels=[
  {goal:[0.88,0.84], walls:[[0.22,0.16,0.52,0.04],[0.22,0.16,0.04,0.22],[0.34,0.36,0.04,0.22],[0.56,0.50,0.30,0.04]]},
  {goal:[0.86,0.18], walls:[[0.12,0.22,0.62,0.04],[0.12,0.22,0.04,0.44],[0.24,0.40,0.60,0.04],[0.52,0.40,0.04,0.28],[0.72,0.56,0.16,0.04]]},
  {goal:[0.12,0.82], walls:[[0.18,0.12,0.04,0.52],[0.18,0.12,0.56,0.04],[0.34,0.26,0.44,0.04],[0.66,0.26,0.04,0.48],[0.34,0.58,0.34,0.04]]},
  {goal:[0.84,0.82], walls:[[0.12,0.18,0.72,0.04],[0.12,0.18,0.04,0.56],[0.24,0.34,0.52,0.04],[0.42,0.34,0.04,0.24],[0.56,0.50,0.28,0.04],[0.72,0.50,0.04,0.22]]}
];
function resize(){W=canvas.width=innerWidth;H=canvas.height=innerHeight;buildLevel();}
addEventListener('resize',resize);
function buildLevel(){const L=levels[(level-1)%levels.length];goal={x:L.goal[0]*W,y:L.goal[1]*H,s:Math.max(28,Math.min(W,H)*0.04)};walls=L.walls.map(v=>({x:v[0]*W,y:v[1]*H,w:v[2]*W,h:v[3]*H}));player={x:Math.max(60,W*0.08),y:Math.max(60,H*0.10),vx:0,vy:0,r:12};currentRun=[];frames=0;win=false;updateHUD();}
function updateHUD(){levelTxt.textContent='Niveau '+level;ghostTxt.textContent='Fantômes: '+ghosts.length;}
function startGame(){if(!started){started=true;overlay.style.display='none';}resize();}
function resetLevel(keepGhost=true){if(!keepGhost)ghosts=[];buildLevel();overlay.style.display='none';}
function endLevel(){win=true;overlay.style.display='flex';overTitle.textContent='Niveau gagné !';overText.textContent='Le prochain niveau est prêt.';ghosts.push(currentRun.slice());updateHUD();}
function failLevel(){ghosts.push(currentRun.slice());overlay.style.display='flex';overTitle.textContent='Raté';overText.textContent='Réessaie: ton parcours devient un fantôme utile.';updateHUD();}
function collide(p){for(const w of walls){if(p.x+p.r>w.x&&p.x-p.r<w.x+w.w&&p.y+p.r>w.y&&p.y-p.r<w.y+w.h){const left=p.x-w.x,right=w.x+w.w-p.x,top=p.y-w.y,bottom=w.y+w.h-p.y,m=Math.min(left,right,top,bottom);if(m===left)p.x=w.x-p.r;else if(m===right)p.x=w.x+w.w+p.r;else if(m===top)p.y=w.y-p.r;else p.y=w.y+w.h+p.r;}}}
function moveFromKeys(){let ax=0,ay=0,s=0.55;if(keys['ArrowLeft']||keys['a'])ax-=s;if(keys['ArrowRight']||keys['d'])ax+=s;if(keys['ArrowUp']||keys['w'])ay-=s;if(keys['ArrowDown']||keys['s'])ay+=s;player.vx=player.vx*0.86+ax;player.vy=player.vy*0.86+ay;player.x+=player.vx*4;player.y+=player.vy*4;collide(player);}
function update(){if(!started)return; if(!win){for(let i=0;i<2;i++){moveFromKeys(); currentRun.push({x:player.x,y:player.y}); frames++; if(Math.hypot(player.x-goal.x,player.y-goal.y)<goal.s*0.75){endLevel(); break;} if(frames>900||player.x<-50||player.y<-50||player.x>W+50||player.y>H+50){failLevel(); break;}}}}
function drawPath(path,alpha){if(path.length<2)return;ctx.strokeStyle=`rgba(124,92,255,${alpha})`;ctx.lineWidth=4;ctx.beginPath();path.forEach((p,i)=>i?ctx.lineTo(p.x,p.y):ctx.moveTo(p.x,p.y));ctx.stroke();}
function render(){ctx.clearRect(0,0,W,H);ctx.fillStyle='#0b1730';ctx.fillRect(0,0,W,H);for(let i=0;i<Math.ceil(W/90);i++){ctx.fillStyle='rgba(255,255,255,.03)';ctx.fillRect(i*90,0,1,H)}for(const w of walls){ctx.fillStyle='#ffb703';ctx.fillRect(w.x,w.y,w.w,w.h)}ctx.fillStyle='#22c55e';ctx.fillRect(goal.x-goal.s/2,goal.y-goal.s/2,goal.s,goal.s);ghosts.forEach((g,i)=>drawPath(g,0.08+0.09*i));ctx.fillStyle='#fff';ctx.beginPath();ctx.arc(player.x,player.y,player.r,0,Math.PI*2);ctx.fill();ctx.fillStyle='#ff4d6d';ctx.beginPath();ctx.arc(player.x+4,player.y-4,2.4,0,Math.PI*2);ctx.fill();ctx.fillStyle='#d7e4ff';ctx.font='14px system-ui';ctx.fillText('WASD / flèches, ou boutons mobiles',16,H-16);ctx.fillText('Fantômes: '+ghosts.length,16,36);ctx.fillText('Niveau '+level,16,56);}
function loop(){update();render();requestAnimationFrame(loop)}
loop();

addEventListener('keydown',e=>{keys[e.key]=true;if(['ArrowUp','ArrowDown','ArrowLeft','ArrowRight',' '].includes(e.key))e.preventDefault();if(e.key==='Enter'&&overlay.style.display==='flex'){overlay.style.display='none';if(win){level++;buildLevel();}else{buildLevel();}}});
addEventListener('keyup',e=>keys[e.key]=false);

function bindTouch(btn){const k=btn.getAttribute('data-k');if(!k)return;const on=()=>{keys[k]=true;};const off=()=>{keys[k]=false;};btn.addEventListener('touchstart',e=>{e.preventDefault();on();},{passive:false});btn.addEventListener('touchend',e=>{e.preventDefault();off();},{passive:false});btn.addEventListener('touchcancel',off);btn.addEventListener('mousedown',on);btn.addEventListener('mouseup',off);btn.addEventListener('mouseleave',off);}document.querySelectorAll('.pad button').forEach(bindTouch);
playBtn.onclick=()=>{startGame();overlay.style.display='none';};
restartBtn.onclick=()=>{ghosts=[];level=1;buildLevel();started=true;overlay.style.display='none';};
nextBtn.onclick=()=>{if(win){level++;buildLevel();overlay.style.display='none';started=true;}};
howBtn.onclick=()=>{helpText.style.display=helpText.style.display==='none'?'block':'none';};
resize();
</script>
</body>
</html>
